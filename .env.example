# Veilgate Environment Configuration Template
# Copy to .env for local runtime overrides. NEVER commit actual .env files containing secrets.

# Local Storage (SQLite WAL mode)
VEILGATE_DB_PATH=./veilgate.db

# Logging (DEBUG | INFO | WARNING | ERROR)
VEILGATE_LOG_LEVEL=INFO

# Cryptography (3-Tier Auto-Provisioning: if empty, auto-stored in OS native keyring)
VEILGATE_MASTER_KEY=

# Declarative Policy File Path
VEILGATE_POLICY_PATH=./policy.yaml

# Dashboard Port (FastAPI)
VEILGATE_DASHBOARD_PORT=7878

# Streamable HTTP Gateway Port
VEILGATE_HTTP_PORT=8765

# Remote MCP Testing Upstream Auth (Optional)
GITHUB_PERSONAL_ACCESS_TOKEN=
